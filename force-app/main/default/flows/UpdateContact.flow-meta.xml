    <decisions>
        <name>Already_Client_Or_Volunteer</name>
        <label>Already Client Or Volunteer</label>
        <locationX>314</locationX>
        <locationY>455</locationY>
        <defaultConnector>
            <targetReference>Set_As_Prospect</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>New (Prospect)</defaultConnectorLabel>
        <rules>
            <name>Keep_Current_Type</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ClientContact__r.Client__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ClientContact__r.Volunteer__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Keep Current Type</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Paperwork_Complete</name>
        <label>Check Paperwork Complete</label>
        <locationX>182</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Already_Client_Or_Volunteer</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Complete (Prospect)</defaultConnectorLabel>
        <rules>
            <name>Paperwork_Done</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Paperwork_Complete__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_As_Client</targetReference>
            </connector>
            <label>Paperwork Complete</label>
        </rules>
    </decisions>
    <description>Sets the related Contact as Prospect on new registration, or Client when Paperwork is marked Complete. A Contact that is already Client or Volunteer is never set back to Prospect. Respects the Only_One validation rule (mutually exclusive Volunteer/Client/Prospect).</description>
